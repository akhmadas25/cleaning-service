// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String?
  role           Role      @default(USER)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]   @relation("CustomerOrders")
  tasks    Order[]   @relation("TechnicianOrders")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  USER
  ADMIN
  TECHNICIAN
}

model ServicePricing {
  id          String      @id @default(cuid())
  serviceType ServiceType @unique
  basePrice   Float       @default(0)
  pricePerSqm Float       @default(0)
  pricePerHour Float      @default(0)
  updatedAt   DateTime    @updatedAt
}

model Order {
  id                  String      @id @default(cuid())
  userId              String
  technicianId        String?
  serviceType         ServiceType
  
  name                String
  phone               String
  
  address             String      @db.Text
  latitude            Float?
  longitude           Float?
  
  technicianLat       Float?
  technicianLng       Float?
  
  areaSqm             Float?
  estimatedHours      Float?
  
  customerPhotoUrl    String?     @db.Text
  status              OrderStatus @default(PENDING)
  
  initialPrice        Float?
  finalPrice          Float?
  completionPhotoUrl  String?     @db.Text
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  user                User        @relation("CustomerOrders", fields: [userId], references: [id])
  technician          User?       @relation("TechnicianOrders", fields: [technicianId], references: [id])
}

enum ServiceType {
  TOILET
  RUMPUT
  RUANGAN
  GUDANG
}

enum OrderStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  CANCELLED
  COMPLETED
  APPROVED
}
